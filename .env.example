# Copy to .env.local for local development. Both values come from your Supabase project
# (Project Settings -> API). The anon key is designed to be public; row-level security protects data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. owner/repo for the "Report a problem" fallback link, when a report cannot be
# sent from the app. Defaults to td8-source/kiwi-math; CI passes the repo it builds from.
VITE_GITHUB_REPO=td8-source/kiwi-math
