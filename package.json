{
  "name": "nature-maths",
  "private": true,
  "version": "0.1.0",
  "description": "Nature Maths: an Aotearoa nature quest that teaches maths to 5-8 year olds, aligned to the New Zealand curriculum",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "screenshots": "node scripts/screenshots.mjs",
    "cloud:check": "node scripts/cloud-check.mjs",
    "showme:check": "node scripts/showme-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-store": "^2.4.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "jsdom": "^27.0.0",
    "playwright": "^1.58.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
